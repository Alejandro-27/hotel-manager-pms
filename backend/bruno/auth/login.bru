meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  {
    "email": "admin@hotel.com",
    "password": "Admin123!"
  }
}

script:post-response {
  if (res.status === 200) {
    const raw = res.headers["set-cookie"]
    const list = Array.isArray(raw) ? raw : (raw ? [raw] : [])
    const cookie = list.map((c) => c.split(";")[0]).find((c) => c.startsWith("token="))
    if (cookie) bru.setVar("token", cookie.slice("token=".length))
  }
}
