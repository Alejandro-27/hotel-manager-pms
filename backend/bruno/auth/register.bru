meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  {
    "name": "Admin Hotel",
    "email": "admin@hotel.com",
    "password": "Admin123!",
    "role": "admin",
    "hotelName": "Hotel Paraíso",
    "acceptTerms": true
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const raw = res.headers["set-cookie"]
    const list = Array.isArray(raw) ? raw : (raw ? [raw] : [])
    const cookie = list.map((c) => c.split(";")[0]).find((c) => c.startsWith("token="))
    if (cookie) bru.setVar("token", cookie.slice("token=".length))
  }
}
