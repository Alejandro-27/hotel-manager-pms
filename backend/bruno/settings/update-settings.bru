meta {
  name: Update Settings
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/settings
  headers {
    Authorization: Bearer {{token}}
    Content-Type: application/json
  }
  body: json
  {
    "legalName": "Hotel Paraiso S.L.",
    "taxId": "B12345678",
    "address": "Calle Mayor 1, 28013 Madrid",
    "phone": "+34910000000",
    "email": "facturacion@hotelparaiso.example",
    "jurisdiction": "Registro Mercantil de Madrid, Tomo 100, Folio 50"
  }
}
