    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^5.1.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "5.7.3"
  }
